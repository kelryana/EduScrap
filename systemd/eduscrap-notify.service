[Unit]
Description=EduScrap - Notificação de Prazos de Editais para Usuários (Item 7 e 8)
After=network.target eduscrap-scraper.service
Requires=eduscrap-scraper.service

[Service]
Type=oneshot
User=ana
WorkingDirectory=/home/ana/projetos/EduScrap
ExecStart=/home/ana/projetos/EduScrap/venv/bin/python /home/ana/projetos/EduScrap/notify_users.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
