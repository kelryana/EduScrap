@startuml arquitetura_eduscrap_clean
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' ==================== ESTILO MINIMALISTA ====================
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName "Arial"
skinparam DefaultFontSize 11
skinparam ArrowColor #333333
skinparam ArrowFontColor #333333
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho
skinparam ArrowFontSize 9

' Cores suaves
!define PRIMARY_COLOR #4A90E2
!define DATA_COLOR #0A6F20
!define EXTERNAL_COLOR #FFB74D

AddElementTag("data", $bgColor=DATA_COLOR, $fontColor="#FFFFFF", $borderColor="#3DA55F", $borderThickness=2)
AddElementTag("scraper", $bgColor=PRIMARY_COLOR, $fontColor="#FFFFFF", $borderColor="#3A76B5", $borderThickness=2)
AddElementTag("external", $bgColor=EXTERNAL_COLOR, $fontColor="#333333", $borderColor="#E69A3A", $borderThickness=2)

skinparam rectangle<<container>> {
    BackgroundColor #F8F9FA
    FontColor #333333
    BorderColor #DEE2E6
    BorderThickness 2
}

skinparam rectangle<<external_system>> {
    BackgroundColor #FFED29
    FontColor #333333
    BorderColor #BA8E23
    BorderThickness 2
}

skinparam rectangle<<boundary>> {
    BackgroundColor #F8F9FA
    BorderColor #4A90E2
    FontColor #333333
    BorderThickness 1
}

SHOW_PERSON_OUTLINE()

title <b>Arquitetura EduScrap</b>

' ==================== ATORES ====================
Person(user, "Usuário", "Estudante")

' ==================== SISTEMA ====================
System_Boundary(eduscrap, "EduScrap") {
    
    ' Interface
    Container(web, "Frontend", "React", "Interface web")
    Container(api, "API", "Flask", "REST API")
    
    ' Dados
    ContainerDb(db, "MongoDB", "NoSQL", "Vagas e editais", $tags="data")
    
    ' Coleta
    Container(scheduler, "Agendador", "Cron", "Rotinas de coleta")
    Container(scrapers, "Scrapers", "Python", "HTML/PDF/JS", $tags="scraper")
    
    ' Processamento
    Container(validator, "Validador", "Python", "Normaliza dados")
}

' ==================== EXTERNOS ====================
System_Ext(uern, "Portais UERN/UFERSA", "HTML")
System_Ext(jouern, "JOUERN", "PDF")
System_Ext(parceiros, "Parceiros", "CIEE")

' ==================== FLUXOS PRINCIPAIS ====================

' Consulta
Rel(user, web, "Acessa", "HTTPS")
Rel(web, api, "API", "JSON")
Rel(api, db, "Lê dados", "READ")

' Coleta
Rel(scheduler, scrapers, "Dispara", "")
Rel(scrapers, uern, "Coleta", "HTML")
Rel(scrapers, jouern, "Baixa", "PDF")
Rel(scrapers, parceiros, "Navega", "JS")

' Processamento
Rel(scrapers, validator, "Envia dados", "")
Rel(validator, db, "Persiste", "WRITE")

@enduml