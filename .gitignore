# ==============================================================================
# .gitignore - EduScrap
# ==============================================================================

# PYTHON & BYTECODE
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# AMBIENTES VIRTUAIS
venv/
env/
.venv/
.env/
virtualenv/
ENV/
*.bak/

# BANCO DE DADOS & DUMPS
*.db
*.sqlite
*.sqlite3
*.dump
mongodb-data/
data/
dump/
*.bson
*.metadata.json

# LOGS & EXECUÇÕES (PRIVADOS)
logs/
*.log
*.log.*
*.tmp
*.temp
*.swp
*.swo
*.bak
*.cache
*.pid
*.seed
*.pid.lock

# DIAGRAMAS & MODELAGENS (PRIVADOS)
diagrams/
diagramas_atualizados/
*.puml
*.plantuml
*.mmd
*.mermaid

# DOCUMENTOS ACADÊMICOS & RELATÓRIOS (PRIVADOS)
documentos_finais/
docs/
documentos/
*.pdf
*.docx
*.doc
*.odt
*.pptx
*.ppt
*.xlsx
*.xls
.~lock.*

# SCRAPING - DADOS TEMPORÁRIOS & OUTPUTS
cache/
temp/
scraped_data/
output/

# IMAGENS & PRINTS GERADOS (PRIVADOS)
*.png
*.jpg
*.jpeg
*.svg
*.gif
*.webp

# Libera APENAS os assets oficiais de UI do Frontend (logos, ícones)
!frontend/assets/
!frontend/assets/**

# CONFIGURAÇÕES & SEGREDOS (PRIVADOS)
.env
.env.local
.env.*.local
*.env
config.local.py
settings.local.py
secrets.py
secrets.json

# ARQUIVOS JSON DE CONFIGURAÇÃO (LIBERADOS)
*.json
!config/*.json
!config/**/*.json

# EDITORES & SISTEMA
.vscode/
.idea/
*.iml
.project
.classpath
.settings/
*.sublime-*
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
*.orig
*.rej
*.patch
*.diff

# TESTES E COBERTURA
.coverage
htmlcov/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# FRONTEND TEMPORÁRIOS
frontend/*.log
frontend/*.tmp
!frontend/*.html
!frontend/*.js
!frontend/*.css
